                      scheduled pipeline:
pipeline {
    agent any

    triggers {
        cron('H * * * *')
    }

    stages {
        stage('Show Time') {
            steps {
                powershell 'Get-Date'
            }
        }
    }
} 

                      param pipeline:
pipeline {
    agent any
    parameters {
        string(name: 'USERNAME', defaultValue: 'enter your name', description: 'Enter your name')
    }
    stages {
        stage('1') {
            steps {
                echo "1 ${params.USERNAME}"
            }
        }
    }
}

